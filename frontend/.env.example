# URL da API .NET vista pelo servidor do Next (rewrite de /api e componentes de servidor)
API_INTERNAL_URL=http://localhost:5080
# URL pública do site (canônicas, sitemap, Open Graph). Sem barra no final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Segredo compartilhado com a API (Site:RevalidateSecret) para o endpoint /revalidate
REVALIDATE_SECRET=dev-revalidate-secret-change-me
# Tiles do mapa (Leaflet). Padrão: OpenStreetMap.
NEXT_PUBLIC_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
