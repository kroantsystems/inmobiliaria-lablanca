{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "lablanca-api",
    "Audience": "lablanca-site",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Storage": {
    "RootPath": "storage"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "RateLimiting": {
    "Login": { "PermitLimit": 5, "WindowSeconds": 60 },
    "PublicForms": { "PermitLimit": 10, "WindowSeconds": 3600 },
    "Analytics": { "PermitLimit": 120, "WindowSeconds": 60 }
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  }
}
